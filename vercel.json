{
  "git": {
    "deploymentEnabled": false
  },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/data.js": {
      "includeFiles": "private-data/**",
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron-trigger-build",
      "schedule": "10 23 * * *"
    }
  ]
}
