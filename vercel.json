{
  "git": {
    "deploymentEnabled": false
  },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" }
  ],
  "functions": {
    "api/data.js": {
      "includeFiles": "private-data/**",
      "maxDuration": 10
    }
  }
}
